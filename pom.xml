<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>javalin-vue-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>javalin-vue-app</name>

    <properties>
        <!-- Java 25 release flag (preferred over source/target for Java 9+) -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javalin.version>7.2.0</javalin.version>
        <jackson.version>2.21.2</jackson.version>
        <javafx.version>21.0.1</javafx.version>
    </properties>

    <!--
        OS-detection profiles to supply the correct JavaFX native classifier.
        Without the classifier, the JavaFX JARs omit platform-specific native
        libraries and the app will fail to load WebView / graphics pipeline.
    -->
    <profiles>
        <profile>
            <id>linux</id>
            <activation>
                <os><family>unix</family></os>
            </activation>
            <properties><javafx.platform>linux</javafx.platform></properties>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
        <profile>
            <id>mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties><javafx.platform>mac</javafx.platform></properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!-- mssql-jdbc ships only jre8 and jre11 classifiers; jre11 runs fine on Java 21 -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>12.8.1.jre11</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.2.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- release supersedes source+target for Java 9+ cross-compilation -->
                    <release>25</release>
                </configuration>
            </plugin>
            <!--
                javafx-maven-plugin automatically adds the module-path and
                add-modules flags for JavaFX 21. Use mvn javafx:run instead
                of exec:java to ensure the JVM module system is configured.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.example.desktop.Launcher</mainClass>
                    <options>
                        <!--
                            Suppress "restricted method" warnings from JavaFX native loaders.
                            javafx.graphics uses System::load; javafx.web binds native methods.
                            These are expected for JavaFX and do not indicate a problem.
                        -->
                        <option>--enable-native-access=javafx.graphics,javafx.web</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
